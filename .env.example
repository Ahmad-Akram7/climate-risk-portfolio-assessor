# Copy to .env  (all optional - the app works with none of these, on synthetic data)
# Open-Meteo paid plan key (https://open-meteo.com/en/pricing). Needed before selling reports built on its data.
OPEN_METEO_API_KEY=
NVIDIA_API_KEY=            # AI report via NVIDIA Nemotron 3.5 Lightning (https://build.nvidia.com)
NOAA_CDO_TOKEN=            # NOAA Climate Data Online token (https://www.ncdc.noaa.gov/cdo-web/token)
NASA_FIRMS_KEY=            # NASA FIRMS MAP_KEY (https://firms.modaps.eosdis.nasa.gov/api/map_key/)
# OpenTopography Point Elevation API: https://portal.opentopography.org/requestService?service=api
OPENTOPOGRAPHY_API_KEY=
# LLM_BASE_URL=https://integrate.api.nvidia.com/v1   # any OpenAI-compatible endpoint
# LLM_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
# LLM_TIMEOUT=300          # seconds to wait for the AI report
# CRPA_OFFLINE=1            # never touch the network
# CRPA_MAX_ASSETS=500
# CRPA_MAX_UPLOAD_MB=5        # API upload size cap
# CRPA_MAX_JOBS=100           # finished API jobs kept in memory
# White-label branding for the dashboard and report
# CRPA_BRAND_NAME=Your Company
# CRPA_BRAND_TAGLINE=Physical climate risk screening
# CRPA_BRAND_COLOR=#1d4ed8
# CRPA_BRAND_FOOTER=Prepared by Your Company
